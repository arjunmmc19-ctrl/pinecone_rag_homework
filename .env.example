# Copy this file to .env and fill in real values. Never commit .env.

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=apple-10k-2025
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# OpenAI (used for embeddings + chat model)
OPENAI_API_KEY=your_openai_api_key_here

# Qdrant (local, on-disk embedded mode — not a secret, no server or
# account needed). Optional: defaults to ./qdrant_data next to qdrant_core.py.
QDRANT_PATH=./qdrant_data
